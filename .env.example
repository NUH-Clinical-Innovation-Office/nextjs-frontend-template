# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env.local for local development.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle.
# Variables without the prefix stay server-side only.
# =============================================================================

# The base URL of the application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development

# -----------------------------------------------------------------------------
# common-service
# -----------------------------------------------------------------------------
# Base URL of common-service, used server-side by /api/notes.
#
# Deliberately not NEXT_PUBLIC_: in the cluster this resolves only from inside,
# because common-service has no ingress. The browser never sees it.
#
# In-cluster default:
#   http://common-service.sample-services.svc.cluster.local:8080
COMMON_SERVICE_URL=http://localhost:8080

# Developer API key identifying this app as a Consumer Backend.
#
# This is the supported way to reach common-service. It is sent as `X-API-Key`;
# common-service exchanges it at auth-service for a short-lived, audience-bound
# JWT and caches that token. When set, the UI collects no credential at all.
#
# A token from auth-service's /oauth2/token does NOT work as a substitute:
# its `aud` defaults to the requesting client_id and common-service rejects it
# with 401. Only a token produced by the API-key exchange is accepted.
#
# Deliberately not NEXT_PUBLIC_: this is a real credential. Leave unset for
# local development and the UI falls back to asking for a bearer token.
# NEVER commit a real key - source it from the platform secret manager.
# COMMON_SERVICE_API_KEY=<from-secret-manager>

# Upstream request timeout in milliseconds.
API_TIMEOUT=10000
